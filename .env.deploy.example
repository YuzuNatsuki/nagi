# 手元の Cloud Run デプロイ用（コピーして .env.deploy にリネーム。`.env.deploy` は gitignore）
#
#   cp .env.deploy.example .env.deploy
#   # GCP_PROJECT_ID を実値に
#   ./scripts/deploy-cloud-run.sh
#
# 詳細は scripts/deploy-cloud-run.sh の先頭コメントを参照。

GCP_PROJECT_ID=

# Firebase の project ID が GCP のプロジェクト IDと違うときだけ書く（省略時は deploy スクリプトが GCP_PROJECT_ID と同じにする）
# FIREBASE_PROJECT_ID=

# 省略可（デフォルトは gcp-api-image.yml と同じ）
# REGION=asia-northeast1
# REPOSITORY=nagi
# IMAGE_NAME=nagi-api
# SERVICE=nagi-api
# IMAGE_TAG=latest
